# Comma-separated Split-Phase or OpenAI-compatible chat/completions URLs
XFY_UPSTREAM_URLS=http://127.0.0.1:8081/v1/chat/completions
# Optional Bearer / X-API-Key matching upstream urls (comma-separated if multiple)
XFY_SERVICE_KEY=
# Optional node metadata (comma-separated)
XFY_UPSTREAM_IDS=local-1
XFY_UPSTREAM_GPUS=L4
XFY_UPSTREAM_CAPS=4
# Optional public model display name
XFY_PUBLIC_MODEL_NAME=xiaofeiyu-v4
# Optional anonymized telemetry webhook
XFY_LOG_WEBHOOK_URL=
XFY_LOG_WEBHOOK_SECRET=
XFY_IP_HASH_SALT=change-me-random-salt
